# PostgreSQL Database Credentials Template
# Copy this file to .env and adjust credentials according to your local PostgreSQL setup

# Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=f1_telemetry
DB_USER=postgres
DB_PASSWORD=postgres

# Optional: Set to 1 or true to force SQLite fallback if PostgreSQL server is not running locally
# USE_SQLITE_FALLBACK=0
