# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
.venv-*/
venv/
env/
ENV/

# Python packaging and build output
build/
dist/
*.egg-info/
pip-wheel-metadata/
*.whl

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials/

# Editors and operating systems
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Jupyter
.ipynb_checkpoints/

# Project-generated runtime files
cache/
logs/
*.log
*.tmp
*.temp

# Generated datasets: keep directory placeholders, not large data files.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Keep metadata and its directory structure version-controlled.
!data/metadata/
!data/metadata/**
